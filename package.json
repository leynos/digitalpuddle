{
  "name": "digitalpuddle",
  "version": "0.1.0",
  "description": "A local DigitalOcean API simulator for deterministic infrastructure tests.",
  "keywords": [
    "emulation",
    "digitalocean-api",
    "cloud-simulator",
    "integration testing",
    "infrastructure testing",
    "mock",
    "mocking",
    "simulation"
  ],
  "bugs": {
    "url": "https://github.com/leynos/digitalpuddle/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leynos/digitalpuddle.git"
  },
  "packageManager": "bun@1.3.11",
  "bin": "bin/start.cjs",
  "files": [
    "README.md",
    "dist",
    "src",
    "schema"
  ],
  "type": "module",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./*"
      ]
    }
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "audit": "bun run scripts/run-audit.mjs",
    "bench": "bun test --bench",
    "build": "tsdown",
    "check:types": "bun run generate && bunx tsc --noEmit",
    "docs:check": "typedoc --options typedoc.json",
    "fmt": "bunx @biomejs/biome format --write .",
    "generate": "graphql-codegen",
    "lint": "bunx @biomejs/biome lint .",
    "prepack": "bun run generate && bun run build",
    "start": "node --experimental-transform-types --watch ./example/start.ts",
    "start:bin": "node ./bin/start.cjs",
    "sync:openapi:digitalocean": "bun --bun sync-digitalocean-openapi.ts",
    "sync:schema:rest": "node --experimental-transform-types ./sync.ts",
    "test": "bun test --max-concurrency=1 tests",
    "test:watch": "bun test --watch tests",
    "tsc": "bun run check:types"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@graphql-tools/utils": "^12.0.1",
    "@simulacrum/foundation-simulator": "^0.8.0",
    "assert-ts": "^0.3.4",
    "express": "^5.2.1",
    "graphql": "^16.9.0",
    "graphql-yoga": "^5.24.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@biomejs/biome": "^2.5.15",
    "@graphql-codegen/cli": "^7.4.3",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-resolvers": "^6.1.0",
    "@octokit/graphql": "^9.0.5",
    "@redocly/cli": "2.57.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "bun-types": "^1.4.2",
    "fast-check": "^4.10.2",
    "publint": "^0.3.25",
    "tsdown": "^0.23.0",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@fastify/busboy": "3.2.2",
    "@graphql-tools/executor-legacy-ws": "1.1.37",
    "@graphql-tools/utils": "12.0.3",
    "@opentelemetry/core": "2.8.0",
    "body-parser": "2.3.0",
    "brace-expansion": "5.0.12",
    "browserslist": "4.28.9",
    "dompurify": "3.4.11",
    "fast-uri": "3.1.8",
    "http-proxy-middleware": "4.1.1",
    "immutable": "5.1.9",
    "js-yaml": "4.3.2",
    "lodash": "4.18.1",
    "markdown-it": "14.3.2",
    "protobufjs": "7.6.4",
    "proxy-addr": "2.0.8",
    "qs": "6.16.0",
    "shell-quote": "1.12.0",
    "ws": "8.21.0"
  },
  "inlinedDependencies": {
    "starfx": "0.16.1"
  },
  "main": "./dist/index.cjs"
}
